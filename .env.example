# Copy to .env and set ADMIN_API_KEY (leaving it empty leaves /admin/* unprotected)
QDRANT_COLLECTION=docs
GEN_MODEL=llama3.2:3b
EMBED_MODEL=bge-m3
# OLLAMA_URL and QDRANT_URL come from compose service names

# RAG tuning parameters
MIN_SIMILARITY_SCORE=0.4
MAX_CONTEXT_CHUNKS=8
RETRIEVE_MULTIPLIER=1.5

# Admin API key for protected endpoints (/admin/ingest, /admin/delete, /admin/list)
ADMIN_API_KEY=

# Chat log retention for /chatbot/dashboard (365 keeps the nginx backfill back to Dec 2025)
STATS_RETENTION_DAYS=365
